# Production Docker Compose settings. Copy to .env on the VPS and chmod 600.
POSTGRES_USER=novel_sync
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=novel_sync
HOST_PORT=8087

# Exact comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=https://your-frontend.example.com

# Initial private account. The token is hashed before it is stored in PostgreSQL.
BOOTSTRAP_USER_EMAIL=you@example.com
BOOTSTRAP_TOKEN=replace-with-at-least-32-random-characters

# Default: 512 MiB. Caddy must allow at least the same request size.
MAX_ARCHIVE_BYTES=536870912
